# AI Voice Worker — provider: gemini (default) | openai
AI_VOICE_PROVIDER=gemini

# Gemini Live backend: vertex (recommended; uses VERTEX_AI_CREDENTIALS) | google (API key)
GEMINI_LIVE_BACKEND=vertex
# Vertex GA live model (override with gemini-3.1-flash-live-preview when available on your backend)
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_LOCATION=us-central1

# Google AI Studio key (only if GEMINI_LIVE_BACKEND=google and Live API enabled on the key)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# OpenAI Realtime fallback (AI_VOICE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy

# Public HTTPS/WSS base of this service (Railway URL, no trailing slash)
PUBLIC_BASE_URL=https://v25dashcallsbackend-development.up.railway.app

# Telnyx — AI outbound needs a Call Control Application (not Credential Connection)
TELNYX_API_KEY=
TELNYX_CALL_CONTROL_APP_ID=
# Optional fallbacks (prefer CALL_CONTROL_APP_ID above)
# TELNYX_APPLICATION_ID=
# TELNYX_CONNECTION_ID=

# Optional fixed Agent ObjectId for AI-originated Call docs
# AI_VOICE_AGENT_ID=
