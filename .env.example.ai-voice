# OpenAI Realtime Voice (company AI outbound)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# Public HTTPS/WSS base of this service (Railway URL, no trailing slash)
PUBLIC_BASE_URL=https://v25dashcallsbackend-development.up.railway.app

# Telnyx — AI outbound needs a Call Control Application (not Credential Connection)
TELNYX_API_KEY=
TELNYX_CALL_CONTROL_APP_ID=
# Optional fallbacks (prefer CALL_CONTROL_APP_ID above)
# TELNYX_APPLICATION_ID=
# TELNYX_CONNECTION_ID=

# Optional fixed Agent ObjectId for AI-originated Call docs
# AI_VOICE_AGENT_ID=
